{
  "name": "oneshot-zap",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "X(Twitter) の各ポストに「スパム報告→ブロック」を1発で実行するボタンを足す Chrome 拡張",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm run icons && pnpm run typecheck && pnpm run build"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "esbuild": "^0.24.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
