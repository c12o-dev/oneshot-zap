{
  "manifest_version": 3,
  "name": "oneshot-zap",
  "version": "0.1.0",
  "description": "X(Twitter) の各ポストに『スパム報告→ブロック』を1発で実行するボタンを足す",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
